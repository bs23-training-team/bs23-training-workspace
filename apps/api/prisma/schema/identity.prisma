//Authentication part 

enum UserRole {
  PM
  TRAINEE
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  credentials             Credential[]
  sessions                Session[]
  invitations             AccountInvitation[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
}

model User {
  id                 String    @id @default(uuid())
  workspaceId        String
  name               String
  email              String    @unique
  role               UserRole
  emailVerifiedAt    DateTime?
  activatedAt        DateTime?
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  credential Credential?
  sessions   Session[]

  receivedInvitations AccountInvitation[] @relation("InvitedUser")
  createdInvitations  AccountInvitation[] @relation("InvitationCreator")

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([workspaceId])
}

model Credential {
  id           String   @id @default(uuid())
  workspaceId  String
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
}

model Session {
  id               String    @id @default(uuid())
  workspaceId      String
  userId           String
  refreshTokenHash String
  device           String?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([userId])
  @@index([expiresAt])
}

model AccountInvitation {
  id              String    @id @default(uuid())
  workspaceId     String
  userId          String
  createdByUserId String
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation("InvitedUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User      @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([userId])
  @@index([expiresAt])
}






