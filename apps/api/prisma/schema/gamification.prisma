// ============================================================================
// Owner: E09 + E10 (XP ledger, levels, streaks, badges, quests, hackathons, kudos, leaderboard)
// Planned records (SRS p.8): XPRule, XPEvent, XPReview, Level, Streak, Freeze, Badge, Audit,
// Quest, QuestProgress, LeaderboardPreference, Hackathon, HackathonEntry, Kudos, KudosReview
//
// Gamification | schema/v1 draft | 2026-11-11
// Edit ONLY the existing apps/api/prisma/schema/gamification.prisma.
// No generator/datasource here; base.prisma is owned by E11.
// Rules and an example: see README.md in this folder.
//
// Cross-module references (no relation, so no change to other owners' files):
// - workspaceId is the E01 Workspace.id.
// - traineeUserId and every *ByUserId field is an E01 User.id. Backend checks that the
//   user belongs to the workspace and has the right role (PM or TRAINEE).
// - E02 resolves trainee profile details (e.g. BS23001) from traineeUserId.
// - leaveId (StreakFreeze) is an E07 LeaveRequest.id, sourceRef (XpEvent) points to the
//   E03/E05/E06 record that caused the XP.
// When E01/E02 are merged, these scalars can become relations with named inverse fields.
// All internal relations include workspaceId. Do not format the full schema folder:
// that can change other owners' files.
// API/business validation enforces: XP awarded once per key, daily/weekly caps, kudos send
// limit and cooldown, immutable published hackathons and the XP status lifecycle.
// ============================================================================

enum XpSource {
  VERIFIED_MODULE
  ON_TIME_SPRINT
  FINAL_ASSESSMENT
  HACKATHON_PARTICIPATION
  HACKATHON_WINNER
  KUDOS
  STREAK_MILESTONE
  MANUAL_ADJUSTMENT
}

enum XpStatus {
  PENDING
  AWARDED
  HELD
  REJECTED
  REVERSED
}

enum BadgeKind {
  BEHAVIORAL
  TECHNICAL
  SPECIAL
}

enum KudosCategory {
  HELPFUL
  GREAT_EXPLANATION
  TEAMWORK
}

enum FreezeSource {
  LEAVE
  HOLIDAY
}

// ---------- Rules and levels ----------

// A new version is a new row. Only one version per workspace is active (enforced by backend).
model XpRuleSet {
  id                      String   @id @default(uuid())
  workspaceId             String
  version                 Int
  isActive                Boolean  @default(false)
  verifiedModuleXp        Int      @default(10)
  verifiedModuleDailyCap  Int      @default(30)
  onTimeSprintXp          Int      @default(20)
  finalAssessmentXp       Int      @default(40)
  hackathonXp             Int      @default(80)
  kudosXp                 Int      @default(5)
  kudosSendLimitPerWeek   Int      @default(3)
  kudosCooldownDays       Int      @default(7)
  kudosReceivedCapPerWeek Int      @default(15)
  streakMilestoneXp       Int      @default(25)
  pmReviewMultiplier      Decimal  @default(1) @db.Decimal(4, 2)
  engagementDropAlertPct  Int      @default(30)
  sprintCutoff            String   @default("10:00") // HH:mm
  updatedByUserId         String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  levels XpLevel[]
  events XpEvent[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, version])
  @@index([workspaceId, isActive])
}

// Example levels: Rookie 0, Builder 250, Pro 750, Expert 1500.
model XpLevel {
  id          String   @id @default(uuid())
  workspaceId String
  ruleSetId   String
  name        String
  minXp       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ruleSet XpRuleSet @relation(fields: [workspaceId, ruleSetId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, ruleSetId, name])
  @@unique([workspaceId, ruleSetId, minXp])
}

// ---------- Experience Points ----------

// Ledger row, never deleted. A wrong award is REVERSED, not removed.
// key makes an award happen once, e.g. xp:topic.verified:<attemptId>.
model XpEvent {
  id              String    @id @default(uuid())
  workspaceId     String
  traineeUserId   String
  ruleSetId       String
  source          XpSource
  amount          Int
  status          XpStatus  @default(PENDING)
  key             String
  sourceEvent     String?
  sourceRef       String?
  evidence        Json      @default("{}") @db.JsonB
  reason          String?   @db.Text
  suspicious      Boolean   @default(false)
  dayOf           DateTime  @db.Date
  weekStart       DateTime  @db.Date
  occurredAt      DateTime
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ruleSet XpRuleSet @relation(fields: [workspaceId, ruleSetId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  kudos   Kudos?

  @@unique([workspaceId, id])
  @@unique([workspaceId, key])
  @@index([workspaceId, traineeUserId, status, dayOf])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, weekStart, status])
}

// ---------- Streaks ----------

model StreakDay {
  id            String   @id @default(uuid())
  workspaceId   String
  traineeUserId String
  day           DateTime @db.Date
  onTime        Boolean
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, traineeUserId, day])
}

// reason is private, PM only.
model StreakFreeze {
  id              String       @id @default(uuid())
  workspaceId     String
  traineeUserId   String
  day             DateTime     @db.Date
  source          FreezeSource
  reason          String       @db.Text
  leaveId         String?
  grantedByUserId String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, traineeUserId, day])
}

// ---------- Quests ----------

model Quest {
  id              String   @id @default(uuid())
  workspaceId     String
  name            String
  description     String   @default("") @db.Text
  goal            String
  target          Int
  rewardXp        Int      @default(0)
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  progress QuestProgress[]

  @@unique([workspaceId, id])
  @@index([workspaceId, startDate, endDate])
}

model QuestProgress {
  id               String    @id @default(uuid())
  workspaceId      String
  questId          String
  traineeUserId    String
  count            Int       @default(0)
  verifiedByUserId String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  quest Quest @relation(fields: [workspaceId, questId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, questId, traineeUserId])
  @@index([workspaceId, traineeUserId])
}

// ---------- Badges ----------

model Badge {
  id          String    @id @default(uuid())
  workspaceId String
  key         String
  name        String
  icon        String
  kind        BadgeKind
  criteria    Json?     @db.JsonB
  target      Int?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  awards BadgeAward[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, key])
  @@index([workspaceId, kind, isActive])
}

// awardedByUserId is the PM for TECHNICAL badges. A badge is awarded once per trainee.
model BadgeAward {
  id                   String   @id @default(uuid())
  workspaceId          String
  badgeId              String
  traineeUserId        String
  evidence             Json     @default("{}") @db.JsonB
  awardedByUserId      String?
  assessmentAttemptRef String?
  projectReviewRef     String?
  awardedAt            DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  badge Badge @relation(fields: [workspaceId, badgeId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, badgeId, traineeUserId])
  @@index([workspaceId, traineeUserId])
}

// ---------- Hackathons ----------

model Hackathon {
  id                String    @id @default(uuid())
  workspaceId       String
  name              String
  brief             String    @db.Text
  scheduledAt       DateTime
  durationMin       Int
  createdByUserId   String
  published         Boolean   @default(false)
  publishedAt       DateTime?
  publishedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  entries HackathonEntry[]

  @@unique([workspaceId, id])
  @@index([workspaceId, scheduledAt])
}

model HackathonEntry {
  id             String    @id @default(uuid())
  workspaceId    String
  hackathonId    String
  traineeUserId  String
  url            String
  notes          String    @default("") @db.Text
  score          Int? // 0-100, validated by backend
  feedback       String?   @db.Text
  isWinner       Boolean   @default(false)
  scoredByUserId String?
  scoredAt       DateTime?
  submittedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  hackathon Hackathon @relation(fields: [workspaceId, hackathonId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, hackathonId, traineeUserId])
  @@index([workspaceId, traineeUserId])
}

// ---------- Kudos and leaderboard ----------

// xpEventId links the XP created by this kudos (null while pending or when no XP is given).
model Kudos {
  id               String        @id @default(uuid())
  workspaceId      String
  fromUserId       String
  toUserId         String
  category         KudosCategory
  message          String        @db.Text
  sentAt           DateTime      @default(now())
  weekStart        DateTime      @db.Date
  suspicious       Boolean       @default(false)
  reviewedByUserId String?
  reviewedAt       DateTime?
  xpEventId        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  xpEvent XpEvent? @relation(fields: [workspaceId, xpEventId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, xpEventId])
  @@index([workspaceId, fromUserId, weekStart])
  @@index([workspaceId, fromUserId, toUserId, sentAt])
  @@index([workspaceId, toUserId, weekStart])
}

model LeaderboardPreference {
  id            String   @id @default(uuid())
  workspaceId   String
  traineeUserId String
  hideName      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, traineeUserId])
}
