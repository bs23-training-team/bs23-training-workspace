{
  "name": "@bs23/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared public API types (DTOs, enums, IDs) used by both apps/api and apps/web.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
