// ---------------------------------------------------------------------------

// COLLISION RESOLUTION WITH E03's assessment.prisma (3 duplicate models)

// ---------------------------------------------------------------------------

// E03's assessment.prisma and this file were authored independently for the

// same SRS domain (SRS p.10 lists E03 as owner of ExpertiseVersion, Attempt,

// Result, Appeal, Recommendation). Three model names collided:

//

//   M7 model (this file)     E03 model (assessment.prisma)

//   -----------------------   ------------------------------------------

//   ExpertiseVersion          ExpertiseVersion

//   AssessmentAttempt         AssessmentAttempt

//   AssessmentResult          AssessmentResult

//

// The three pairs are NOT interchangeable — they encode two different

// lifecycles for the same domain, so the M7 models were renamed rather than

// deleted or merged:

//

//   ExpertiseVersion     -> ExpertiseProfileVersion

//     E03's ExpertiseVersion is the ten-answer onboarding QUESTIONNAIRE

//     document (traineeUserId, answers JSON, DRAFT/SUBMITTED/SUPERSEDED).

//     M7's is a frozen, versioned SNAPSHOT OF AN ExpertiseProfile, carrying

//     the derived skill state and the assessed level (INIT-05). M7's

//     ExpertiseProfile + ExpertiseProfileTechnology have no E03 equivalent,

//     so the profile side stays and only the version model is renamed.

//

//   AssessmentAttempt    -> AssessmentFormAttempt

//     E03's attempt is POLICY-driven: it requires a published

//     AssessmentPolicy + AssessmentProctoringPolicy, carries session leases,

//     proctoring events and idempotency keys, and its kind is INITIAL/RETEST

//     only. M7's attempt is FORM-driven: it runs a frozen AssessmentForm

//     (sections, question versions, rubric snapshot, attempt policy,

//     acknowledgement) and additionally covers COURSE assessments, which

//     E03's model cannot express at all. E03's attempt therefore cannot

//     absorb M7's form-driven attempt without changing assessment.prisma,

//     which is out of scope for this change.

//

//   AssessmentResult     -> AssessmentFormResult

//     E03's result is JOB-bound: it requires a jobId and an

//     evaluationRevision, carries evidenceHash/breakdown/analysis and is

//     immutable once PUBLISHED. M7's result is CHAIN-bound: D-5 mandates a

//     linear supersedes chain (supersedesId, at most one successor,

//     sequential versions) plus courseOutcome and provisional/final

//     lifecycle. E03's model has no successor pointer, so it cannot carry

//     D-5. The two models coexist as two distinct record kinds.

//

// All three renames are name-only: no approved M7 decision (D-1..D-22) was

// reopened, and no field, constraint, index or deletion behaviour was

// dropped. See the per-model notes for the exact column-level mapping.

//

// Cross-module references use plain scalar IDs with a `// → Model.id (Owner)`

// comment, per docs/week1-team-brief.md. Prisma relations are declared ONLY

// between models that exist in this file. User and Workspace are owned by E01

// and ARE delivered (identity.prisma), but identity.prisma is not editable

// here, so M7 keeps `workspaceId` as a plain scoped column and declares no

// @relation against Workspace/User — exactly as E03 does for the models it

// owns. TraineeProfile (E02) and CourseVersion (E04) are not delivered yet,

// so they are scalar-only as well (see D-6).

//

// E11 SQL requirements (NOT enforced by Prisma — see each TODO below):

//   1. Composite FK: AssessmentFormAttempt(expertiseProfileId,

//      expertiseProfileVersionId) -> ExpertiseProfileVersion(

//      expertiseProfileId, id)                                    [D-4 / A-6]

//      Expressed as the Prisma relation

//      `AssessmentFormAttempt.expertiseProfileVersion`, so Prisma emits the

//      composite FK itself. E11 confirms it in the generated migration.

//   2. CHECK: AssessmentFormAttempt expertise pair is both-NULL or

//      both-populated                                              [D-4 / A-10]

//      Not expressible in Prisma's DSL; needs E11 raw SQL.

//   3. Composite FK: EvaluationJob(assessmentResultId, assessmentAttemptId)

//      -> AssessmentFormResult(id, attemptId)                        [A-8]

//      Expressed as the Prisma relation `EvaluationJob.assessmentResult`,

//      so Prisma emits the composite FK itself. E11 confirms it in the

//      generated migration.

//   4. Composite FK: Recommendation(expertiseProfileId,

//      expertiseProfileVersionId) -> ExpertiseProfileVersion(

//      expertiseProfileId, id)                                    [A-12]

//      Not expressible in Prisma's DSL; needs E11 raw SQL. NOTE: D-4's

//      approved scope does NOT extend to Recommendation; see the D-8 scope

//      note on Recommendation for the current rule.

//   5. Parent candidate UNIQUE keys required by 1 and 4:

//      ExpertiseProfileVersion(expertiseProfileId, id)

//      AssessmentFormResult(id, attemptId)  — required by 3 as well

//   6. Partial UNIQUE index: AssessmentFormResult(attemptId)

//      WHERE "supersedesId" IS NULL   — at most one root result per attempt

//                                                    [D-5, E11 recommendation]

//      Requires previewFeatures = ["partialIndexes"] in base.prisma (E11 file).

// ============================================================================



// ---------------------------------------------------------------------------

// Enums

// ---------------------------------------------------------------------------



/// Joining role declared by the trainee during the expertise onboarding survey.

/// INIT-01: the declared role is stored separately from the PM-assigned

/// position and never overwrites it.

enum JoiningRole {

  FRONTEND

  BACKEND

  FULL_STACK

  SOFTWARE_ENGINEER

  QA

  DEVOPS

  OTHER

}



/// Technologies covered by the expertise survey and the skill catalog.

/// INIT-02 defines the supported list; OTHER carries a free-text detail.

enum Technology {

  JAVASCRIPT

  REACT

  NEXT_JS

  NODE_JS

  LARAVEL

  PHP

  PYTHON

  JAVA

  MYSQL

  POSTGRESQL

  DOCKER

  GIT_GITHUB

  OTHER

}



/// Self-reported experience level. INIT-03: Beginner / Intermediate / Advanced.

/// Self-confidence never adds marks (INIT-05).

enum ExperienceLevel {

  BEGINNER

  INTERMEDIATE

  ADVANCED

}



/// Self-reported confidence. INIT-03: Not / Somewhat / Confident / Very Confident.

/// Never contributes marks to a score.

enum ConfidenceLevel {

  NOT_CONFIDENT

  SOMEWHAT_CONFIDENT

  CONFIDENT

  VERY_CONFIDENT

}



/// Improvement interests chosen during onboarding. INIT-03.

enum ImprovementArea {

  FUNDAMENTALS

  PROBLEM_SOLVING

  BACKEND

  FRONTEND

  DATABASE

  ARCHITECTURE

  API

  TESTING_CODE_QUALITY

  OTHER

}



/// Kind of question in a frozen assessment form. EXAM-01 freezes questions;

/// INIT-04 mixes objective questions with a required practical explanation.

enum QuestionKind {

  OBJECTIVE

  WRITTEN

  PRACTICAL

  CODE

}



/// Difficulty band of a question. INIT-04 selects questions per level:

/// Beginner foundation+applied, Intermediate foundation+advanced,

/// Advanced applied+advanced.

enum QuestionLevel {

  FOUNDATION

  APPLIED

  ADVANCED

}



/// Which assessment an attempt belongs to. INIT-04/INIT-06 cover the initial

/// expertise assessment; EXAM-01..EXAM-04 cover course exams.

enum AssessmentType {

  INITIAL

  RETEST

  COURSE

}



/// Lifecycle of an attempt. EXAM-02: an explicit or timeout submission

/// finalizes exactly once; refresh/retry must not extend time or duplicate

/// results.

enum AttemptStatus {

  NOT_STARTED

  IN_PROGRESS

  SUBMITTED

  TIMED_OUT

  GRADING

  GRADED

  FINALIZED

  CANCELLED

}



/// Lifecycle of a result. EXAM-03: provisional results are excluded from final

/// averages, mastery and eligible XP.

enum ResultStatus {

  PROVISIONAL

  FINAL

  SUPERSEDED

  INVALIDATED

}



/// What caused an attempt to be submitted. EXAM-02 distinguishes an explicit

/// submission from a server-deadline timeout.

enum SubmissionTrigger {

  EXPLICIT

  TIMEOUT

}



/// Kind of AI/automated evaluation job. AI-01: rubrics are applied to written,

/// practical and code review; code runs in a disposable isolated runner.

enum EvaluationJobKind {

  AI_WRITTEN_REVIEW

  AI_CODE_REVIEW

  AUTOMATED_TEST_RUN

  HUMAN_REVIEW

}



/// Lifecycle of an evaluation job. AI-05: on timeout or invalid output the job

/// ends pending/failed/review-required; a previous valid result is preserved.

enum EvaluationJobStatus {

  QUEUED

  RUNNING

  SUCCEEDED

  FAILED

  TIMED_OUT

  REVIEW_REQUIRED

  CANCELLED

}



/// Outcome of a course assessment under the published versioned policy.

/// EXAM-03: Done >= 80%, Needs revision 60-79%, Weak < 60%.

enum CourseOutcome {

  DONE

  NEEDS_REVISION

  WEAK

}



/// Initial assessed level derived from the objective score. INIT-05:

/// Advanced >= 80%, Intermediate 60-79%, Beginner < 60%.

enum InitialLevel {

  BEGINNER

  INTERMEDIATE

  ADVANCED

}



/// Lifecycle of an appeal. EXAM-04: retain the appeal reason and review

/// provenance.

enum AppealStatus {

  SUBMITTED

  UNDER_REVIEW

  ACCEPTED

  REJECTED

  WITHDRAWN

}



/// Per-skill assessment outcome of a recommendation. AI-03: assessed

/// per-skill baseline Strong >= 80%, Developing 60-79%, Needs revision < 60%.

/// Untested = NOT_ASSESSED; profile-only suggestions = UNASSESSED.

/// These two are genuinely distinct and must not be merged.

enum RecommendationSkillStatus {

  STRONG

  DEVELOPING

  NEEDS_REVISION

  NOT_ASSESSED

  UNASSESSED

}



// ---------------------------------------------------------------------------

// Catalog: skills, role requirements, questions, rubrics, forms

// ---------------------------------------------------------------------------



/// A technical skill in the catalog. INIT-02/INIT-04: unsupported skills stay

/// honestly labelled as unassessed rather than being scored.

model Skill {

  id          String   @id @default(uuid())

  workspaceId String

  name        String

  slug        String   @unique

  technology  Technology

  description String?

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt



  /// Cross-module reference to the owning course catalog entry (E04).

  courseId String? // → Course.id (E04)



  roleRequirements RoleRequirement[]

  profileTechnologies ExpertiseProfileTechnology[]

  recommendations   Recommendation[]

  questions         Question[]



  @@index([workspaceId])

  @@index([technology])

}



/// The skills expected for a joining role, with a required weight.

/// INIT-01/INIT-02/AI-03: recommendations use role requirements and

/// demonstrated gaps.

model RoleRequirement {

  id          String   @id @default(uuid())

  workspaceId String

  skillId     String

  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Restrict)

  role        JoiningRole

  priority    Int      @default(0)

  required    Boolean  @default(true)

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt



  @@unique([skillId, role])

  @@index([workspaceId, role])

}



/// A question. The question body is versioned; `Question` holds identity only.

model Question {

  id          String   @id @default(uuid())

  workspaceId String

  kind        QuestionKind

  level       QuestionLevel

  skillId     String?

  skill       Skill?   @relation(fields: [skillId], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt



  versions QuestionVersion[]



  /// TODO (PENDING D-1 APPROVAL): QuestionSolution.questionId redundancy —

  /// whether the solution should point directly at Question (identity) in

  /// addition to its QuestionVersion link. Provisional design keeps the

  /// QuestionVersion link as the only version-carrying reference and leaves

  /// QuestionSolution.questionId out until D-1 is decided.



  @@index([workspaceId])

  @@index([skillId])

}



/// A frozen version of a question. INIT-04 and EXAM-01 freeze question and

/// rubric versions; a published version is never overwritten.

model QuestionVersion {

  id            String   @id @default(uuid())

  workspaceId   String

  questionId    String

  question      Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  versionNumber Int

  prompt        String

  /// Stable identifier used by rubrics, AI evidence and results.

  questionCode  String

  /// Marks available for this question under the frozen policy.

  maxMarks      Decimal  @default(0) @db.Decimal(10, 2)

  /// Options for objective questions, stored as JSON.

  options       Json?

  /// Version label of the policy that produced maxScore.

  policyVersion String

  createdAt     DateTime @default(now())

  updatedAt     DateTime @updatedAt



  solutions       QuestionSolution[]

  rubricVersions  RubricVersion[] @relation("QuestionVersionRubrics")

  formQuestions   AssessmentFormQuestion[] @relation("FormQuestionVersion")

  attemptQuestions AttemptQuestion[]



  /// TODO (PENDING D-2 APPROVAL): QuestionVersion.modelAnswer redundancy —

  /// whether the model/expected answer is stored on the question version and

  /// duplicated by the rubric version, or owned by exactly one side.

  /// Provisional design stores the expected answer on QuestionSolution and

  /// leaves QuestionVersion.modelAnswer out until D-2 is decided.



  @@unique([questionId, versionNumber])

  @@index([workspaceId])

}



/// The expected/correct answer for one objective question version.

/// AUTH-02: answer keys are never returned by the API.

model QuestionSolution {

  id                String         @id @default(uuid())

  workspaceId       String

  questionVersionId String

  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)

  answerKey         Json

  explanation       String?

  createdAt         DateTime       @default(now())

  updatedAt         DateTime       @updatedAt



  /// TODO (PENDING D-1 APPROVAL): QuestionSolution.questionId redundancy —

  /// see the note on Question. Not added until D-1 is decided.



  @@unique([questionVersionId])

  @@index([workspaceId])

}



/// A rubric. The rubric body is versioned; `Rubric` holds identity and a

/// pointer to its current version.

model Rubric {

  id          String   @id @default(uuid())

  workspaceId String

  name        String

  /// Pointer to the current published rubric version.

  currentVersionId String? @unique // → RubricVersion.id (self relation, see below)

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt



  currentVersion RubricVersion? @relation("RubricCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)

  versions       RubricVersion[]  @relation("RubricVersions")



  /// TODO (PENDING D-3 APPROVAL): Rubric.currentVersionId enforcement —

  /// whether the pointer must resolve to a version belonging to this rubric is

  /// currently an application rule only; a composite FK

  /// (Rubric(id, currentVersionId) -> RubricVersion(id, rubricId)) would need

  /// E11 raw SQL. Not added until D-3 is decided.



  /// D-7 (APPROVED, Option 4a): rubric granularity is form-level. A rubric

  /// version may be referenced by any number of forms; there is no

  /// form-scoped uniqueness rule. Section-level overrides are deferred

  /// until D-18 confirms they are a product requirement.



  @@index([workspaceId])

}



/// A frozen rubric version. EXAM-01 freezes the rubric; sections and criteria

/// are versioned content.

model RubricVersion {

  id            String   @id @default(uuid())

  workspaceId   String

  rubricId      String

  rubric        Rubric   @relation("RubricVersions", fields: [rubricId], references: [id], onDelete: Restrict)

  /// The rubric version this rubric currently points at (D-3 pending).

  currentOfRubric Rubric? @relation("RubricCurrentVersion")

  versionNumber Int

  /// Frozen scoring scale and criteria, stored as JSON.

  sections      Json

  maxMarks      Decimal  @default(0) @db.Decimal(10, 2)

  policyVersion String

  createdAt     DateTime @default(now())

  updatedAt     DateTime @updatedAt



  /// The question version this rubric version scores, when the rubric is

  /// question-scoped.

  questionVersionId String?

  questionVersion   QuestionVersion? @relation("QuestionVersionRubrics", fields: [questionVersionId], references: [id], onDelete: Restrict)



  /// D-7 (APPROVED, Option 4a): the forms this rubric version is bound to.

  /// AssessmentForm.rubricVersionId is the form-level binding.

  assessmentForms  AssessmentForm[]

  /// D-7 (APPROVED, Option 4a): the attempt items that snapshotted this

  /// rubric version. AttemptQuestion.rubricVersionId is the per-item

  /// snapshot that keeps historical grading assignments stable.

  attemptQuestions AttemptQuestion[]



  @@unique([rubricId, versionNumber])

  @@index([workspaceId])

  @@index([questionVersionId])

}



/// A frozen assessment form. EXAM-01 freezes instructions, questions, rubric,

/// duration and attempt policy.

model AssessmentForm {

  id          String   @id @default(uuid())

  workspaceId String

  title       String

  type        AssessmentType

  instructions String

  /// Frozen duration in whole minutes (SRS: integer minutes, no floats).

  durationMinutes Int?

  /// Frozen attempt policy, stored as JSON (max attempts, retry rules).

  attemptPolicy Json?

  /// Version label of the frozen policy.

  policyVersion String

  /// Whether the trainee must acknowledge the instructions before starting.

  requiresAcknowledgement Boolean @default(true)

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt



  /// Cross-module reference to the E04 catalog.

  courseId        String? // → Course.id (E04)

  /// D-6 (APPROVED, Option B): optional scalar pointer to the E04 course

  /// version this form is bound to. E04 has not delivered CourseVersion, so

  /// NO Prisma relation is declared here.

  courseVersionId String? // → CourseVersion.id (E04) — model not yet delivered

  topicId         String? // → Topic.id (E04)



  /// Cross-module reference to the trainee (E02).

  traineeId String? // → TraineeProfile.id (E02)



  /// D-7 (APPROVED, Option 4a): the rubric version applied to this form's

  /// questions. Bound to a SPECIFIC RubricVersion id, never to

  /// Rubric.currentVersionId: the current version is a moving pointer and

  /// would make an attempt's rubric basis drift over time.

  ///

  /// This is the only configuration-level rubric binding in the 4a design.

  /// Section-level overrides are deferred until D-18 confirms they are a

  /// product requirement; if D-18 resolves affirmatively this becomes the

  /// form default and a section override would replace it.

  ///

  /// Limitation (D-19, accepted): this FK enforces EXISTENCE of the rubric

  /// version only. It does NOT enforce that the referenced RubricVersion

  /// belongs to the same workspace as this form.

  rubricVersionId String?

  rubricVersion   RubricVersion? @relation(fields: [rubricVersionId], references: [id], onDelete: Restrict)



  sections   AssessmentFormSection[]

  questions  AssessmentFormQuestion[]

  attempts   AssessmentFormAttempt[]

  results    AssessmentFormResult[]



  /// TODO (E11 SQL, A-19): composite FK

  /// AssessmentForm(courseId, courseVersionId) -> CourseVersion(id, courseId)

  /// is BLOCKED until E04 delivers CourseVersion. Not added here.



  @@index([workspaceId])

  @@index([courseVersionId])

  @@index([traineeId])

  @@index([rubricVersionId])

}



/// A section of an assessment form, holding ordered questions.

model AssessmentFormSection {

  id          String   @id @default(uuid())

  workspaceId String

  assessmentFormId String

  assessmentForm   AssessmentForm @relation(fields: [assessmentFormId], references: [id], onDelete: Restrict)

  title       String

  order       Int

  /// Instructions shown for this section.

  instructions String?

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt



  questions AssessmentFormQuestion[]



  @@unique([assessmentFormId, order])

  @@index([workspaceId])

}



/// The frozen link between a form and one question version. INIT-04/EXAM-01:

/// the form pins the exact question version that was reviewed.

model AssessmentFormQuestion {

  id                String   @id @default(uuid())

  workspaceId       String

  assessmentFormId  String

  assessmentForm    AssessmentForm @relation(fields: [assessmentFormId], references: [id], onDelete: Restrict)

  sectionId         String?

  section           AssessmentFormSection? @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  questionVersionId String

  questionVersion   QuestionVersion @relation("FormQuestionVersion", fields: [questionVersionId], references: [id], onDelete: Restrict)

  order             Int

  maxMarks          Decimal  @default(0) @db.Decimal(10, 2)

  createdAt         DateTime @default(now())

  updatedAt         DateTime @updatedAt



  attemptQuestions AttemptQuestion[]



  @@unique([assessmentFormId, questionVersionId])

  @@index([workspaceId])

  @@index([sectionId])

}



// ---------------------------------------------------------------------------

// Expertise: profile, versions, technologies

// ---------------------------------------------------------------------------



/// The trainee's expertise profile. Holds the declared onboarding survey.

model ExpertiseProfile {

  id          String   @id @default(uuid())

  workspaceId String

  traineeId   String

  joiningRole JoiningRole

  /// Free-text detail for OTHER role/technology/improvement choices.

  otherDetails Json?

  experienceLevel ExperienceLevel

  improvementAreas ImprovementArea[]

  /// Non-empty goals captured during onboarding (INIT-01).

  goals       String

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt



  /// Pointer to the current published expertise version.

  currentVersionId String? @unique // → ExpertiseProfileVersion.id (self relation, see below)



  currentVersion ExpertiseProfileVersion? @relation("ExpertiseCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)

  versions       ExpertiseProfileVersion[]  @relation("ExpertiseVersions")



  technologies ExpertiseProfileTechnology[]

  attempts     AssessmentFormAttempt[]

  results      AssessmentFormResult[]

  recommendations Recommendation[]



  /// TODO (PENDING D-9 APPROVAL): ExpertiseProfile.currentVersionId relation

  /// naming — the named self-relation "ExpertiseCurrentVersion" above is the

  /// provisional choice; the final relation name is pending D-9.



  @@index([workspaceId])

  @@index([traineeId])

}



/// A frozen expertise version: the survey answer set and the derived skill

/// state at that point in time. INIT-04/INIT-06 freeze profile versions;

/// a retest creates a new version and keeps history.

///

/// RENAMED from `ExpertiseVersion` (collision with E03's assessment.prisma

/// `ExpertiseVersion`, which is the ten-answer onboarding questionnaire

/// document). E03's model has no ExpertiseProfile, no

/// ExpertiseProfileTechnology rows and no derived-level snapshot, so it cannot

/// express this concept. The rename is name-only: fields, constraints,

/// indexes and deletion behaviour are unchanged.

model ExpertiseProfileVersion {

  id                 String   @id @default(uuid())

  workspaceId        String

  expertiseProfileId String

  expertiseProfile   ExpertiseProfile @relation("ExpertiseVersions", fields: [expertiseProfileId], references: [id], onDelete: Restrict)

  /// The expertise profile that currently points at this version.

  currentOfProfile   ExpertiseProfile? @relation("ExpertiseCurrentVersion")

  versionNumber      Int

  /// Frozen survey answers and derived skill state, stored as JSON.

  snapshot           Json

  /// Assessed level derived under the frozen threshold policy (INIT-05).

  initialLevel       InitialLevel?

  /// Version label of the threshold policy used to derive initialLevel.

  thresholdVersion   String?

  createdAt          DateTime @default(now())

  updatedAt          DateTime @updatedAt



  attempts         AssessmentFormAttempt[]

  results          AssessmentFormResult[]

  recommendations  Recommendation[]



  @@unique([expertiseProfileId, versionNumber])

  /// Candidate unique key required by the A-6 and A-12 composite FKs

  /// (E11 raw SQL): AssessmentFormAttempt(expertiseProfileId,

  /// expertiseProfileVersionId) and Recommendation(expertiseProfileId,

  /// expertiseProfileVersionId)

  ///   -> ExpertiseProfileVersion(expertiseProfileId, id).

  /// Column order matches the child key order. It is also the parent key

  /// referenced by the Prisma relation

  /// `AssessmentFormAttempt.expertiseProfileVersion`, so Prisma requires it.

  @@unique([expertiseProfileId, id])

  @@index([workspaceId])

}



/// A technology declared by the trainee on the expertise profile.

model ExpertiseProfileTechnology {

  id          String   @id @default(uuid())

  workspaceId String

  expertiseProfileId String

  expertiseProfile   ExpertiseProfile @relation(fields: [expertiseProfileId], references: [id], onDelete: Restrict)

  skillId     String?

  skill       Skill?   @relation(fields: [skillId], references: [id], onDelete: Restrict)

  technology  Technology

  experienceLevel ExperienceLevel

  confidenceLevel  ConfidenceLevel

  otherDetail String?

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt



  @@unique([expertiseProfileId, technology])

  @@index([workspaceId])

  @@index([skillId])

}



// ---------------------------------------------------------------------------

// Attempts, responses, evaluations, results

// ---------------------------------------------------------------------------



/// One trainee's attempt at one assessment form. EXAM-02: the server owns the

/// deadline; the attempt finalizes exactly once.

///

/// RENAMED from `AssessmentAttempt` (collision with E03's assessment.prisma

/// `AssessmentAttempt`). E03's attempt is POLICY-driven — it requires a

/// published AssessmentPolicy and AssessmentProctoringPolicy and owns

/// session leases and proctoring events, and its kind is INITIAL/RETEST only.

/// This attempt is FORM-driven: it runs a frozen AssessmentForm (sections,

/// question versions, rubric snapshot, attempt policy, acknowledgement) and

/// additionally covers COURSE assessments, which E03's model cannot express.

/// The rename is name-only: fields, constraints, indexes and deletion

/// behaviour are unchanged, and D-4 is preserved in full.

model AssessmentFormAttempt {

  id               String   @id @default(uuid())

  workspaceId      String

  assessmentFormId String

  assessmentForm   AssessmentForm @relation(fields: [assessmentFormId], references: [id], onDelete: Restrict)

  traineeId        String

  /// Sequential attempt number per (trainee, form).

  attemptNumber    Int

  type             AssessmentType

  attemptStatus    AttemptStatus @default(NOT_STARTED)

  startedAt        DateTime?

  submittedAt      DateTime?

  /// Server deadline (EXAM-02). Frozen duration in whole minutes lives on the form.

  deadlineAt       DateTime?

  gradingStartedAt DateTime?

  gradedAt         DateTime?

  /// Trainee acknowledgement of the frozen instructions (EXAM-01).

  acknowledgedAt   DateTime?

  /// Snapshot of the acknowledgement text that was shown and accepted.

  acknowledgementTextSnapshot String?

  /// Frozen attempt policy at launch time, stored as JSON.

  attemptPolicySnapshot Json?

  createdAt        DateTime @default(now())

  updatedAt        DateTime @updatedAt



  /// D-4 (APPROVED, Option B): the expertise pair is either both NULL

  /// (course-only assessment) or both populated (initial/retest assessment

  /// pinning one expertise version).

  ///

  /// COLUMN RENAME (name-only, D-4 unchanged): the columns were

  /// `expertiseProfileId` / `expertiseVersionId` and are now

  /// `expertiseProfileId` / `expertiseProfileVersionId`. The second column

  /// must point at the M7 profile-version model, which is now called

  /// `ExpertiseProfileVersion` because E03 owns the model name

  /// `ExpertiseVersion` for a different concept (the onboarding questionnaire

  /// document). D-4's approved semantics — both-NULL-or-both-populated, the

  /// version belonging to the profile, the composite FK and the CHECK

  /// constraint — are unchanged.

  expertiseProfileId String? // → ExpertiseProfile.id

  expertiseProfileVersionId String? // → ExpertiseProfileVersion.id

  expertiseProfile   ExpertiseProfile? @relation(fields: [expertiseProfileId], references: [id], onDelete: Restrict)

  /// D-4 / A-6 composite relation:

  /// AssessmentFormAttempt(expertiseProfileId, expertiseProfileVersionId)

  ///   -> ExpertiseProfileVersion(expertiseProfileId, id).

  /// The child column names do not have to match the parent column names, so

  /// the child field expertiseProfileVersionId maps onto the parent field id.

  /// The parent candidate UNIQUE key

  /// ExpertiseProfileVersion @@unique([expertiseProfileId, id]) is required

  /// and is declared on that model.

  ///

  /// This relation is what makes "the expertise version belongs to the

  /// specified expertise profile" a database fact rather than an application

  /// rule: the FK column expertiseProfileId points at

  /// ExpertiseProfileVersion.expertiseProfileId, which is itself an FK to

  /// ExpertiseProfile.id.

  expertiseProfileVersion ExpertiseProfileVersion? @relation(fields: [expertiseProfileId, expertiseProfileVersionId], references: [expertiseProfileId, id], onDelete: Restrict)



  questions AttemptQuestion[]

  responses AttemptResponse[]

  jobs     EvaluationJob[]

  results  AssessmentFormResult[]

  appeals  Appeal[]



  /// TODO (E11 SQL, D-4 / A-10): the both-NULL-or-both-populated rule is NOT

  /// expressible in Prisma's DSL and needs a CHECK constraint in E11 raw SQL.

  /// The composite FK of A-6 IS now emitted by Prisma through the relation

  /// `expertiseProfileVersion` above; E11 confirms it in the generated

  /// migration and confirms that the FK keeps onDelete Restrict.

  /// The CHECK must also cover the case where expertiseProfileId is populated

  /// while expertiseProfileVersionId is NULL, because PostgreSQL's default

  /// MATCH SIMPLE semantics leave such a row unconstrained by the composite

  /// FK.



  /// TODO (E11 SQL, A-15 — PENDING SCOPE SELECTION): the invalid mapping

  /// AssessmentFormResult.assessmentResultId/attemptId/traineeId ->

  /// AssessmentFormAttempt(id, attemptId, traineeId) is NOT used, because

  /// AssessmentFormAttempt has no `attemptId` field and AssessmentFormResult.

  /// assessmentResultId references the result chain, not the attempt.

  /// The two valid alternatives remain pending:

  ///   Option A: AssessmentFormResult(attemptId, traineeId)

  ///             -> AssessmentFormAttempt(id, traineeId)

  ///   Option B: AssessmentFormResult(attemptId, traineeId, assessmentFormId)

  ///             -> AssessmentFormAttempt(id, traineeId, assessmentFormId)

  /// Both need E11 raw SQL and a parent candidate UNIQUE key. No A-15

  /// composite FK and no A-15-specific parent unique key are added here.



  @@unique([traineeId, assessmentFormId, attemptNumber])

  @@index([workspaceId, assessmentFormId])

  @@index([workspaceId, deadlineAt])

  @@index([deadlineAt])

  @@index([traineeId])

  @@index([expertiseProfileId, expertiseProfileVersionId])

}



/// One question inside an attempt, with the answer the trainee gave.

model AttemptQuestion {

  id                       String   @id @default(uuid())

  workspaceId              String

  attemptId                String

  attempt                  AssessmentFormAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  /// The form question this attempt question came from.

  assessmentFormQuestionId String

  assessmentFormQuestion   AssessmentFormQuestion @relation(fields: [assessmentFormQuestionId], references: [id], onDelete: Restrict)

  order                    Int

  maxMarks                 Decimal  @default(0) @db.Decimal(10, 2)

  createdAt                DateTime @default(now())

  updatedAt                DateTime @updatedAt



  /// Provisional question-version provenance (D-10 PENDING).

  questionVersionId String?

  questionVersion   QuestionVersion? @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)



  /// D-7 (APPROVED, Option 4a): snapshot of the rubric version applied to

  /// THIS item at attempt creation. Resolved once from the form's rubric

  /// binding (AssessmentForm.rubricVersionId) and never updated at

  /// application level. Null means no rubric was assigned to this item.

  ///

  /// Deliberately nullable: null is a meaningful state ("no rubric

  /// assigned"), and the FK still forbids a dangling reference for any

  /// non-null value.

  ///

  /// Guarantee (qualified): this snapshot keeps the rubric ASSIGNMENT

  /// stable against later changes to the form or rubric configuration. It

  /// does NOT guarantee grading reproducibility across evaluator

  /// implementations, AI model versions or human graders — those are not

  /// recorded anywhere in M7 (D-14, D-22).

  ///

  /// Limitation (D-19, accepted): this FK enforces EXISTENCE only. It does

  /// NOT enforce same-workspace ownership of the referenced RubricVersion.

  rubricVersionId String?

  rubricVersion   RubricVersion? @relation(fields: [rubricVersionId], references: [id], onDelete: Restrict)



  responses AttemptResponse[]

  revisions AnswerRevision[]



  /// TODO (PENDING D-10 APPROVAL): AttemptQuestion provenance. The provisional

  /// design keeps BOTH assessmentFormQuestionId (mandatory) and

  /// questionVersionId (optional), which leaves two sources for one fact and

  /// requires an application rule that the two agree. Option 4 would remove

  /// questionVersionId and keep assessmentFormQuestionId as the single source

  /// of truth, eliminating that rule structurally. NOT applied here because

  /// D-10 is unapproved. Option 4 also changes the report read path to two

  /// hops and needs an E08 query-performance review.



  @@unique([attemptId, assessmentFormQuestionId])

  @@index([workspaceId])

  @@index([questionVersionId])

  @@index([rubricVersionId])

}



/// The trainee's answer to one attempt question. EXAM-01 autosaves versioned

/// answers with saved/error state and recovers accepted answers after refresh.

model AttemptResponse {

  id          String   @id @default(uuid())

  workspaceId String

  attemptId   String

  attempt     AssessmentFormAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  /// The attempt the response belongs to. This is the same attempt that

  /// attemptQuestionId resolves to via AttemptQuestion.attemptId; it is

  /// denormalized here so AssessmentFormAttempt.responses is a real Prisma

  /// relation (Prisma cannot express a relation through another model).

  /// The single-column FK proves EXISTENCE only, never that the two agree;

  /// keeping them consistent is an application rule, as for the other

  /// denormalized attempt references (see the A-15 note on

  /// AssessmentFormAttempt).

  attemptQuestionId String

  attemptQuestion   AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Restrict)

  /// Free-text or structured answer payload, stored as JSON.

  answer        Json?

  /// Autosave state for the answer.

  savedAt       DateTime?

  /// Whether the last save was rejected.

  saveError     String?

  /// Marks awarded by the deterministic backend scorer.

  awardedScore  Decimal? @db.Decimal(10, 2)

  /// Marks available for this question.

  maxMarks      Decimal? @db.Decimal(10, 2)

  createdAt     DateTime @default(now())

  updatedAt     DateTime @updatedAt



  revisions AnswerRevision[]

  evaluations EvaluationResult[]



  @@index([workspaceId])

  @@index([attemptQuestionId])

  @@index([attemptId])

}



/// A revision of a submitted answer. Append-only: no updatedAt, because a

/// revision is historical evidence (SRS: preserve question/results history).

model AnswerRevision {

  id                String   @id @default(uuid())

  workspaceId       String

  attemptResponseId String

  attemptResponse   AttemptResponse @relation(fields: [attemptResponseId], references: [id], onDelete: Restrict)

  attemptQuestionId String

  attemptQuestion   AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Restrict)

  versionNumber     Int

  answer            Json?

  savedAt           DateTime

  createdAt         DateTime @default(now())



  @@unique([attemptResponseId, versionNumber])

  @@index([workspaceId])

  @@index([attemptQuestionId])

}



/// A durable AI/automated evaluation job. AI-02: store provider, prompt,

/// rubric and job versions, statuses and bounded retry history. SRS: AI and

/// sync work runs as durable jobs, never in-memory only.

model EvaluationJob {

  id          String   @id @default(uuid())

  workspaceId String

  attemptId   String

  attempt     AssessmentFormAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  kind        EvaluationJobKind

  jobStatus   EvaluationJobStatus @default(QUEUED)

  /// Which result version this job was produced for.

  assessmentResultId String?

  /// The attempt that the produced result belongs to. This is a separate

  /// snapshot reference, kept alongside assessmentResultId so the job can be

  /// checked for staleness (INIT-06: stale jobs cannot overwrite newer

  /// results). It is NOT the same field as EvaluationJob.attemptId, which is

  /// the attempt the job was launched against.

  assessmentAttemptId String?

  /// A-8 composite relation: EvaluationJob(assessmentResultId,

  /// assessmentAttemptId) -> AssessmentFormResult(id, attemptId). The child column

  /// names do not have to match the parent column names, so the child field

  /// assessmentAttemptId maps onto the parent field attemptId. The parent

  /// candidate UNIQUE key is AssessmentFormResult @@unique([id, attemptId]).

  /// Both child columns are optional, so this relation is optional too.

  assessmentResult   AssessmentFormResult? @relation(fields: [assessmentResultId, assessmentAttemptId], references: [id, attemptId], onDelete: Restrict)

  /// Provider, model and prompt version identifiers (AI-02).

  provider    String?

  modelVersion String?

  promptVersion String?

  rubricVersionId String?

  /// Bounded retry history, stored as JSON.

  retryHistory Json?

  /// Retry counter, bounded.

  retryCount   Int      @default(0)

  queuedAt    DateTime @default(now())

  startedAt   DateTime?

  finishedAt  DateTime?

  /// Timeout deadline for the job.

  timeoutAt   DateTime?

  /// Failure or review reason.

  failureReason String?

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt



  results EvaluationResult[]



  /// TODO (E11 SQL, A-8): composite FK

  /// EvaluationJob(assessmentResultId, assessmentAttemptId)

  ///   -> AssessmentFormResult(id, attemptId)

  /// ensures the job's result belongs to the job's attempt. The child column

  /// names do not have to match the parent column names, so the child field

  /// assessmentAttemptId maps onto the parent field attemptId. This composite

  /// mapping is now declared as the Prisma relation `assessmentResult` above,

  /// which Prisma renders as the composite FK

  /// EvaluationJob(assessmentResultId, assessmentAttemptId)

  ///   -> AssessmentFormResult(id, attemptId)

  /// together with the parent candidate UNIQUE key AssessmentFormResult(id,

  /// attemptId). E11 still has to confirm the generated migration matches this

  /// mapping and keeps onDelete Restrict on the composite FK.



  @@index([workspaceId, jobStatus])

  @@index([attemptId])

  @@index([assessmentResultId])

}



/// The output of one evaluation job: rubric-based scoring with evidence.

model EvaluationResult {

  id                String   @id @default(uuid())

  workspaceId       String

  evaluationJobId   String

  evaluationJob     EvaluationJob @relation(fields: [evaluationJobId], references: [id], onDelete: Restrict)

  attemptResponseId String?

  attemptResponse   AttemptResponse? @relation(fields: [attemptResponseId], references: [id], onDelete: Restrict)

  awardedScore      Decimal  @default(0) @db.Decimal(10, 2)

  maxMarks          Decimal  @default(0) @db.Decimal(10, 2)

  /// Per-criterion evidence, stored as JSON.

  scoringEvidence   Json?

  /// Validated response schema of the model output.

  rawOutput         Json?

  /// Whether the backend validated the totals (AI-01).

  totalsValidated   Boolean @default(false)

  /// Whether a human confirmed this evaluation (AI-01: AI assists).

  humanConfirmed    Boolean @default(false)

  /// Whether this evaluation is provisional and therefore excluded from final

  /// averages, mastery and eligible XP (EXAM-03).

  provisional       Boolean  @default(true)

  createdAt         DateTime @default(now())

  updatedAt         DateTime @updatedAt



  @@index([workspaceId])

  @@index([evaluationJobId])

}



/// The scored, versioned outcome of an attempt.

///

/// D-5 (APPROVED, Option B): history is linear. `supersedesId` points at the

/// predecessor version; `@@unique([supersedesId])` forbids a fork (two

/// versions sharing one predecessor) and `@@unique([attemptId, version])`

/// fixes the version number inside an attempt. Historical results are never

/// overwritten.

///

/// RENAMED from `AssessmentResult` (collision with E03's assessment.prisma

/// `AssessmentResult`). E03's result is JOB-bound — it requires a jobId and an

/// evaluationRevision and carries evidenceHash/breakdown/analysis, and it has

/// no successor pointer at all, so it cannot carry D-5's chain. This result is

/// CHAIN-bound: it carries the linear supersedes history, the course outcome

/// and the provisional/final lifecycle. The rename is name-only: fields,

/// constraints, indexes and deletion behaviour are unchanged, and D-5 is

/// preserved in full.

model AssessmentFormResult {

  id          String   @id @default(uuid())

  workspaceId String

  attemptId   String

  attempt     AssessmentFormAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  /// The form the attempt was launched against, kept on the result so the

  /// result chain carries its own form reference.

  assessmentFormId String

  assessmentForm   AssessmentForm @relation(fields: [assessmentFormId], references: [id], onDelete: Restrict)

  traineeId   String

  /// The expertise profile and version this result was produced against.

  ///

  /// SCOPE NOTE (unresolved, no approved decision covers this model): the

  /// approved D-4 Option B and the E11 CHECK/composite-FK list apply to

  /// AssessmentFormAttempt only. D-4's approved scope does NOT extend to

  /// AssessmentFormResult, so the both-NULL-or-both-populated rule and the

  /// "version belongs to profile" rule are NOT currently DB-enforced here,

  /// and no E11 item covers them. The two single-column relations below prove

  /// EXISTENCE only, never RELATIONSHIP. This is a reported finding, not an

  /// approved constraint: extending D-4 to AssessmentFormResult needs a new

  /// decision and would add two E11 items (a CHECK and the composite FK

  /// AssessmentFormResult(expertiseProfileId, expertiseProfileVersionId)

  /// -> ExpertiseProfileVersion(expertiseProfileId, id)).

  ///

  /// COLUMN RENAME (name-only, no decision change): `expertiseVersionId` is

  /// now `expertiseProfileVersionId`, matching the rename of the referenced

  /// M7 model to `ExpertiseProfileVersion` (E03 owns the model name

  /// `ExpertiseVersion` for a different concept).

  expertiseProfileId String?

  expertiseProfileVersionId String?

  expertiseProfile   ExpertiseProfile? @relation(fields: [expertiseProfileId], references: [id], onDelete: Restrict)

  expertiseProfileVersion ExpertiseProfileVersion? @relation(fields: [expertiseProfileVersionId], references: [id], onDelete: Restrict)



  /// Linear version chain (D-5).

  versionNumber Int      @default(1)

  supersedesId  String?

  supersedes    AssessmentFormResult?  @relation("ResultVersions", fields: [supersedesId], references: [id], onDelete: Restrict)

  supersededBy  AssessmentFormResult[] @relation("ResultVersions")



  awardedScore    Decimal? @db.Decimal(10, 2)

  maxMarks        Decimal? @db.Decimal(10, 2)

  /// Aggregated score as a percentage, kept for the 80%/60% thresholds.

  percentage      Decimal? @db.Decimal(5, 2)

  resultStatus    ResultStatus @default(PROVISIONAL)

  /// Assessed level for an initial/retest assessment (INIT-05).

  initialLevel    InitialLevel?

  /// Course outcome under the published versioned policy (EXAM-03).

  courseOutcome   CourseOutcome?

  /// Version label of the scoring/threshold policy used.

  policyVersion   String?

  /// Raw responses and evidence backing this result (INIT-05).

  scoringEvidence Json?

  finalizedAt     DateTime?

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt



  jobs           EvaluationJob[]

  appeals        Appeal[]

  recommendations Recommendation[]



  /// D-5 (APPROVED, Option B): no fork — one predecessor, one successor.

  @@unique([supersedesId])

  /// D-5 (APPROVED, Option B): one version number per attempt.

  @@unique([attemptId, versionNumber])

  /// Candidate unique key required by the A-8 composite FK:

  /// EvaluationJob(assessmentResultId, assessmentAttemptId)

  ///   -> AssessmentFormResult(id, attemptId).

  /// Column order matches the child key order. Not contradictory with

  /// @@unique([attemptId, version]) — a different column set.

  /// This is the criterion referenced by the Prisma relation

  /// EvaluationJob.assessmentResult, so it is required by Prisma as well.

  @@unique([id, attemptId])



  /// TODO (E11 SQL, D-5 — E11 IMPLEMENTATION RECOMMENDATION): at most one

  /// root result per attempt, enforced by the partial unique index

  /// AssessmentFormResult(attemptId) WHERE "supersedesId" IS NULL.

  /// Requires previewFeatures = ["partialIndexes"] in base.prisma (E11 file).

  /// NOT added here because base.prisma must not be modified and the preview

  /// feature is not enabled. Recorded as an E11 implementation recommendation,

  /// not as a reopened user decision.

  ///

  /// Application rules (D-5): the root version is 1; a successor's version is

  /// its predecessor's version + 1; a successor belongs to the same attempt;

  /// the chain cannot form a cycle; historical results are never overwritten.



  /// TODO (E11 SQL, A-15 — PENDING SCOPE SELECTION): see the note on

  /// AssessmentFormAttempt. No A-15 composite FK and no A-15-specific parent

  /// unique key are added here.



  @@index([workspaceId, resultStatus])

  @@index([traineeId])

  @@index([assessmentFormId])

}



/// A trainee appeal against a result. EXAM-04: retain the appeal reason and

/// review provenance.

model Appeal {

  id                 String   @id @default(uuid())

  workspaceId        String

  assessmentResultId String

  assessmentResult   AssessmentFormResult @relation(fields: [assessmentResultId], references: [id], onDelete: Restrict)

  attemptId          String

  attempt            AssessmentFormAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  traineeId          String

  appealReason       String

  appealStatus       AppealStatus @default(SUBMITTED)

  /// Review provenance: who reviewed, when and why.

  reviewedById       String?

  reviewedAt         DateTime?

  reviewNote         String?

  /// The outcome of the review, when it changed the result.

  resolution         String?

  createdAt          DateTime @default(now())

  updatedAt          DateTime @updatedAt



  @@index([workspaceId, appealStatus])

  @@index([assessmentResultId])

}



