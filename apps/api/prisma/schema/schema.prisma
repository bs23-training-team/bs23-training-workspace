enum AttendanceSource {
  ERP
  PM_ENTERED
}

enum IdentityKind {
  TEAMS
  ERP
}

enum MeetingAttendanceStatus {
  ATTENDED
  REPORT_PENDING
  UNMAPPED // Teams name not mapped to a user yet
}

enum LeaveType {
  PERSONAL
  ANNUAL
  OTHER_APPROVED
}

enum LeaveStatus {
  PENDING
  APPROVED
  DECLINED
}

enum ReconciliationStatus {
  OPEN
  RESOLVED
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}


model IdentityMapping {
  id          String       @id @default(uuid())
  workspaceId String
  userId      String
  kind        IdentityKind
  externalId  String 
  mappedById  String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [userId], onDelete: Restrict)
  mappedBy  Pm        @relation("IdentityMapper", fields: [mappedById], references: [pmId], onDelete: Restrict)

  @@unique([workspaceId, kind, externalId])
  @@index([userId])
}

model Attendance {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  date        DateTime  @db.Date
  entryTime   DateTime? @db.Time(0)
  exitTime    DateTime? @db.Time(0) // DB: after entryTime

  hours        Decimal?         @db.Decimal(4, 1)
  lateMinutes  Int              @default(0) // FIX: "Late" (FR-ATT-03)
  isOfficeTrip Boolean          @default(false) // FIX: "office trip" tile (FR-ATT-02)
  source       AttendanceSource @default(ERP) // FIX: row marked "Manual (PM-entered)" (US-74)
  enteredById  String? 

  syncedAt  DateTime? 
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [userId], onDelete: Restrict)
  enteredBy Pm?       @relation("AttendanceEnteredBy", fields: [enteredById], references: [pmId], onDelete: Restrict) 

  @@unique([userId, date]) 
  @@index([workspaceId, date])
}

model MeetingAttendance {
  id            String  @id @default(uuid())
  workspaceId   String
  userId        String? 
  teamsIdentity String
  meeting       String 

  scheduledStart  DateTime
  firstJoinAt     DateTime?
  durationMinutes Int?
  lateMinutes     Int?
  status          MeetingAttendanceStatus @default(REPORT_PENDING) 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User?     @relation(fields: [userId], references: [userId], onDelete: Restrict)

  // back-relations (generated)
  meetingIntervals MeetingInterval[]

  @@index([userId, scheduledStart])
}

model MeetingInterval {
  id                  String   @id @default(uuid())
  workspaceId         String
  meetingAttendanceId String
  joinedAt            DateTime
  leftAt              DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  meetingAttendance MeetingAttendance @relation(fields: [meetingAttendanceId], references: [id], onDelete: Restrict)

  @@index([meetingAttendanceId])
}


model SyncRun {
  id             String         @id @default(uuid())
  workspaceId    String
  integrationKey IntegrationKey
  status         SyncStatus     @default(RUNNING)
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?
  recordsSynced  Int            @default(0)
  error          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([integrationKey, startedAt])
}


model PublicHoliday {
  id          String   @id @default(uuid())
  workspaceId String
  date        DateTime @db.Date
  name        String 
  syncedAt    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, date])
}

model LeaveRequest {
  id          String      @id @default(uuid())
  workspaceId String
  userId      String
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date // DB: not before startDate
