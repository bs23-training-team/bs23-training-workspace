model ReconciliationRequest {
  id           String               @id @default(uuid())
  workspaceId  String
  userId       String
  reason       String               @db.Text
  status       ReconciliationStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime? // FIX
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user       User      @relation(fields: [userId], references: [userId], onDelete: Restrict)
  resolvedBy Pm?       @relation("ReconciliationResolver", fields: [resolvedById], references: [pmId], onDelete: Restrict)

  // back-relations (generated)
  reconciliationDates ReconciliationDate[]

  @@index([userId, status])
}

model ReconciliationDate {
  id          String   @id @default(uuid())
  workspaceId String
  requestId   String
  date        DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  request   ReconciliationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@unique([requestId, date])
}

// ============================================================================
// ===== E08 · reports · Report, PDF, mail ===================================
// ============================================================================

enum ReportPeriodType {
  WEEKLY
  BIWEEKLY
  MONTHLY
  FULL // full training period
}

enum MailStatus {
  QUEUED
  ACCEPTED
  FAILED
}

enum MailPurpose {
  REPORT
  TASK_OWNER_APPROVAL
}


model Report {
  id          String           @id @default(uuid())
  workspaceId String
  userId      String
  periodType  ReportPeriodType
  periodStart DateTime         @db.Date
  periodEnd   DateTime         @db.Date
  sections    Json
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [userId], onDelete: Restrict)

  // back-relations (generated)
  reportVersions ReportVersion[]
  mailDeliveries MailDelivery[]

  @@unique([userId, periodType, periodStart, periodEnd])
}


model ReportVersion {
  id            String    @id @default(uuid())
  workspaceId   String
  reportId      String
  version       String 
  sections      Json 
  note          String?   @db.Text
  savedById     String
  savedAt       DateTime  @default(now())
  publishedById String?
  publishedAt   DateTime? 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  report      Report    @relation(fields: [reportId], references: [id], onDelete: Restrict)
  savedBy     Pm        @relation("ReportVersionSaver", fields: [savedById], references: [pmId], onDelete: Restrict)
  publishedBy Pm?       @relation("ReportVersionPublisher", fields: [publishedById], references: [pmId], onDelete: Restrict)

  // back-relations (generated)
  reportFiles    ReportFile[]
  mailDeliveries MailDelivery[]

  @@unique([reportId, version])
  @@index([reportId, publishedAt])
}


model ReportFile {
  id            String   @id @default(uuid())
  workspaceId   String
  versionId     String 
  filePath      String
  generatedById String
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  version     ReportVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  generatedBy Pm            @relation("ReportFileGenerator", fields: [generatedById], references: [pmId], onDelete: Restrict)

  @@index([versionId])
}


model MailDelivery {
  id              String      @id @default(uuid())
  workspaceId     String
  purpose         MailPurpose
  reportId        String? 
  reportVersionId String? 
  sprintTaskId    String? 
  recipient       String
  subject         String
  status          MailStatus  @default(QUEUED)
  attempts        Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  report        Report?        @relation(fields: [reportId], references: [id], onDelete: Restrict)
  reportVersion ReportVersion? @relation(fields: [reportVersionId], references: [id], onDelete: Restrict)
  sprintTask    SprintTask?    @relation(fields: [sprintTaskId], references: [id], onDelete: Restrict)

  // back-relations (generated)
  mailAttempts MailAttempt[]

  @@index([reportId])
  @@index([sprintTaskId])
  @@index([status])
}

model MailAttempt {
  id          String     @id @default(uuid())
  workspaceId String
  deliveryId  String
  attemptNo   Int
  status      MailStatus
  error       String?
  attemptedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  delivery  MailDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, attemptNo])
}

// ============================================================================
// ===== E09 · growth-core · XP, level, streak, badge ========================
// ============================================================================

enum XpSource {
  ON_TIME_SPRINT
  VERIFIED_MODULE
  FINAL_ASSESSMENT
  KUDOS
  QUEST
  MANUAL_ADJUSTMENT
 
}

enum XpStatus {
  PENDING
  AWARDED
  HELD
  REJECTED
  REVERSED
}

enum FreezeSource {
  LEAVE
  HOLIDAY
}

enum BadgeKind {
  BEHAVIORAL
  SPECIAL
}

enum BadgeRuleType {
  ON_TIME_SPRINT_STREAK 
  SPRINT_STREAK 
  KUDOS_DISTINCT_SENDERS 
  MANUAL
}

enum BadgeAwardSource {
  AUTOMATIC
  MANUAL
}


model XpRule {
  id                      String   @id @default(uuid())
  workspaceId             String   @unique
  verifiedModule          Int      @default(10)
  verifiedModuleDailyCap  Int      @default(30)
  onTimeSprint            Int      @default(20)
  finalAssessment         Int      @default(40)
  kudos                   Int      @default(5)
  kudosSendLimitPerWeek   Int      @default(3)
  kudosCooldownDays       Int      @default(7)
  kudosReceivedCapPerWeek Int      @default(15)
  streakMilestone         Int      @default(25)
  streakMilestoneDays     Int      @default(5)
  pmReviewMultiplier      Decimal  @default(1) @db.Decimal(4, 2)
  engagementDropAlertPct  Int      @default(30)
  sprintCutoff            String   @default("10:00") 
  updatedById             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  updatedBy Pm?       @relation("XpRuleUpdater", fields: [updatedById], references: [pmId], onDelete: Restrict)
  // DB: CHECK all numbers >= 0
}


model Level {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  minXp       Int
  retiredAt   DateTime? 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, retiredAt])
}


model XpEvent {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  source      XpSource
  amount      Int
  status      XpStatus @default(PENDING)
  key         String
  evidence    String
  reason      String? 
  flag        String? 
  occurredOn  DateTime @db.Date
  kudosId     String?
  questId     String?
  attemptId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [userId], onDelete: Restrict)
  kudos     Kudos?    @relation(fields: [kudosId], references: [id], onDelete: Restrict)
  quest     Quest?    @relation(fields: [questId], references: [id], onDelete: Restrict)
  attempt   Attempt?  @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  // back-relations (generated)
  xpReviews XpReview[]
  // DB: a trainee's AWARDED total must not go below 0 after a manual adjustment

  @@unique([workspaceId, key])
  @@index([userId, status, occurredOn])
}


model XpReview {
  id          String   @id @default(uuid())
  workspaceId String
  xpEventId   String
  reviewerId  String
  fromStatus  XpStatus
  toStatus    XpStatus
  reason      String   @db.Text // required
  reviewedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  xpEvent   XpEvent   @relation(fields: [xpEventId], references: [id], onDelete: Restrict)
  reviewer  Pm        @relation("XpReviewer", fields: [reviewerId], references: [pmId], onDelete: Restrict)

  @@index([xpEventId])
}


model Streak {
  id                 String    @id @default(uuid())
  workspaceId        String
  userId             String    @unique
  current            Int       @default(0)
  longest            Int       @default(0)
  lastSubmissionDate DateTime? @db.Date
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [userId], onDelete: Restrict)
}

model StreakFreeze {
  id          String       @id @default(uuid())
  workspaceId String
  userId      String
  date        DateTime     @db.Date
  source      FreezeSource
  reason      String
  grantedById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [userId], onDelete: Restrict)
  grantedBy Pm        @relation("StreakFreezeGrantor", fields: [grantedById], references: [pmId], onDelete: Restrict)

  @@unique([userId, date])
}

model Badge {
  id          String        @id @default(uuid())
  workspaceId String
  name        String
  icon        String // emoji
  kind        BadgeKind
  criteria    String        @db.Text
  ruleType    BadgeRuleType @default(MANUAL)
  threshold   Int?
  createdById String
  retiredAt   DateTime?
  retiredById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  createdBy Pm  @relation("BadgeCreator", fields: [createdById], references: [pmId], onDelete: Restrict)
  retiredBy Pm? @relation("BadgeRetirer", fields: [retiredById], references: [pmId], onDelete: Restrict)

  // back-relations (generated)
  badgeAwards BadgeAward[]

  @@unique([workspaceId, name])
}

model BadgeAward {
  id              String           @id @default(uuid())
  workspaceId     String
  badgeId         String
  userId          String
  source          BadgeAwardSource
  evidence        String           @db.Text // required
  attemptId       String? 
  projectUrl      String? 
  projectReviewed Boolean          @default(false) 
  awardedById     String
  revokedById     String?
  revokeReason    String?          @db.Text
  awardedAt       DateTime         @default(now())
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  badge     Badge     @relation(fields: [badgeId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [userId], onDelete: Restrict)
  awardedBy Pm        @relation("BadgeAwarder", fields: [awardedById], references: [pmId], onDelete: Restrict)
  revokedBy Pm?       @relation("BadgeRevoker", fields: [revokedById], references: [pmId], onDelete: Restrict)
  attempt   Attempt?  @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([badgeId, userId]) // a badge is earned once
  @@index([userId, revokedAt])
}

// ============================================================================
// ===== E10 · engagement · Quest, leaderboard, kudos ========================
// ============================================================================

enum KudosCategory {
  HELPFUL
  GREAT_EXPLANATION
  TEAMWORK
}

model Quest {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String   @db.Text
  target      Int // DB: CHECK >= 1
  reward      Int // XP
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date // DB: not before startDate
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy Pm        @relation("QuestCreator", fields: [createdById], references: [pmId], onDelete: Restrict)

  // back-relations (generated)
  xpEvents        XpEvent[]
  questProgresses QuestProgress[]

  @@index([workspaceId, startDate, endDate])
}

model QuestProgress {
  id           String    @id @default(uuid())
  workspaceId  String
  questId      String
  userId       String
  count        Int       @default(0)
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  quest      Quest     @relation(fields: [questId], references: [id], onDelete: Restrict)
  user       User      @relation(fields: [userId], references: [userId], onDelete: Restrict)
  verifiedBy Pm?       @relation("QuestVerifier", fields: [verifiedById], references: [pmId], onDelete: Restrict)

  @@unique([questId, userId])
  @@index([userId])
}


model LeaderboardPreference {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String   @unique
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [userId], onDelete: Restrict)
}

model Kudos {
  id          String        @id @default(uuid())
  workspaceId String
  fromUserId  String
  toUserId    String
  category    KudosCategory
  message     String        @db.Text
  sentOn      DateTime      @db.Date
  suspicious  Boolean       @default(false) 
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  fromUser  User      @relation("KudosSent", fields: [fromUserId], references: [userId], onDelete: Restrict)
  toUser    User      @relation("KudosReceived", fields: [toUserId], references: [userId], onDelete: Restrict)

  // back-relations (generated)
  xpEvents XpEvent[]
  // DB: CHECK fromUserId <> toUserId

  @@index([fromUserId, sentOn])
  @@index([toUserId, sentOn])
}
