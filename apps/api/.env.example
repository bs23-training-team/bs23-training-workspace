# Copy this file to .env for local development: cp .env.example .env
# Local values only. Never put real/staging/production secrets here.

PORT=4000

# Local Docker Postgres (see infra/docker-compose.yml)
DATABASE_URL="postgresql://bs23:bs23_local_password@localhost:5433/bs23_dev"
# Used only for migrations. On Neon this is the non-pooled (direct) URL.
DIRECT_URL="postgresql://bs23:bs23_local_password@localhost:5433/bs23_dev"

REDIS_URL="redis://localhost:6379"

# Identity (E01). Two DIFFERENT random values, each at least 32 characters.
# Make each one with: openssl rand -hex 32
# Leave them empty here: `pnpm setup:local` fills them in when it creates apps/api/.env.
# The API does not start without them. Never commit real values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Browser origins allowed to call this API (comma separated). Never "*".
CORS_ORIGIN="http://localhost:3000"

# Development only: lets the API return the password-reset token in its response (no mail provider yet).
# Ignored in production. Leave it unset elsewhere.
# IDENTITY_EXPOSE_DEV_TOKENS=true

# Profile photos are stored here (a local folder for now; the real storage provider is not decided yet).
# UPLOAD_DIR="uploads"
