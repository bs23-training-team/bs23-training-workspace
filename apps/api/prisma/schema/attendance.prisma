
// ============================================================
// E08/M08 - Attendance & Leave Management
// File: attendance.prisma
//
// Note:
// - User and TraineeProfile models are owned by other modules.
// - traineeId and reviewerId are scalar references for now.
// - Relations to those models will be added after their models
//   are available and reviewed by their owners.
// - Original ERP and Teams source records must remain unchanged.
// ============================================================


// ------------------------------------------------------------
// 1. Enums
// ------------------------------------------------------------

enum AttendanceSource {
  ERP
  PM_ENTERED
}

enum LeaveType {
  PERSONAL
  ANNUAL
  OTHER_APPROVED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum ReconciliationStatus {
  PENDING
  APPROVED
  DECLINED
}

enum ReconciliationRecordType {
  OFFICE_ATTENDANCE
  MEETING_ATTENDANCE
}

enum IntegrationProvider {
  ERP
  MICROSOFT_TEAMS
}

enum IntegrationConnectionStatus {
  DISCONNECTED
  AUTHORIZATION_REQUIRED
  CONNECTED
  FAILED
  STALE_CACHED_DATA
}

enum MeetingAttendanceStatus {
  PENDING
  AVAILABLE
  UNAVAILABLE
  PROCESSED
}


// ------------------------------------------------------------
// 2. Office Attendance
// ------------------------------------------------------------

model AttendanceRecord {
  id              String           @id @default(uuid())
  workspaceId     String
  traineeId       String

  attendanceDate  DateTime         @db.Date
  entryAt         DateTime?        @db.Timestamptz(6)
  exitAt          DateTime?        @db.Timestamptz(6)

  lateMinutes     Int?
  workingMinutes  Int?

  source          AttendanceSource
  sourceRecordId  String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  reconciliationRequests ReconciliationRequest[]

  @@index([workspaceId])
  @@index([traineeId])
  @@index([workspaceId, attendanceDate])
  @@index([workspaceId, traineeId, attendanceDate])
  @@index([source])
}


// ------------------------------------------------------------
// 3. Microsoft Teams Meetings
// ------------------------------------------------------------

model TeamsMeeting {
  id                String   @id @default(uuid())
  workspaceId       String

  externalMeetingId String
  title             String?
  scheduledStart    DateTime @db.Timestamptz(6)
  scheduledEnd      DateTime? @db.Timestamptz(6)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attendanceRecords MeetingAttendance[]

  @@unique([workspaceId, externalMeetingId])
  @@index([workspaceId])
  @@index([scheduledStart])
}


// ------------------------------------------------------------
// 4. Teams Meeting Attendance
// ------------------------------------------------------------

model MeetingAttendance {
  id                 String                  @id @default(uuid())
  workspaceId        String

  meetingId          String
  traineeId          String?
  teamsUserId        String

  firstJoinAt        DateTime?               @db.Timestamptz(6)
  durationMinutes    Int?
  lateMinutes        Int?

  status             MeetingAttendanceStatus @default(PENDING)

  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  meeting            TeamsMeeting            @relation(fields: [meetingId], references: [id], onDelete: Restrict)

  intervals          MeetingAttendanceInterval[]
  reconciliationRequests ReconciliationRequest[]

  @@index([workspaceId])
  @@index([meetingId])
  @@index([traineeId])
  @@index([workspaceId, traineeId])
}


// ------------------------------------------------------------
// 5. Meeting Attendance Join/Rejoin Intervals
// ------------------------------------------------------------

model MeetingAttendanceInterval {
  id                  String   @id @default(uuid())
  meetingAttendanceId String

  joinedAt            DateTime @db.Timestamptz(6)
  leftAt              DateTime? @db.Timestamptz(6)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  meetingAttendance   MeetingAttendance @relation(fields: [meetingAttendanceId], references: [id], onDelete: Restrict)

  @@index([meetingAttendanceId])
}


// ------------------------------------------------------------
// 6. Leave Requests
// ------------------------------------------------------------

model LeaveRequest {
  id              String             @id @default(uuid())
  workspaceId     String
  traineeId       String

  startDate       DateTime           @db.Date
  endDate         DateTime           @db.Date

  type            LeaveType
  reason          String             @db.Text
  status          LeaveRequestStatus @default(PENDING)

  reviewerId      String?
  reviewedAt      DateTime?          @db.Timestamptz(6)
  reviewNote      String?            @db.Text

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([workspaceId])
  @@index([traineeId])
  @@index([workspaceId, traineeId])
  @@index([workspaceId, status])
  @@index([startDate, endDate])
}


// ------------------------------------------------------------
// 7. Reconciliation Requests
// ------------------------------------------------------------

model ReconciliationRequest {
  id                  String                    @id @default(uuid())
  workspaceId         String
  traineeId           String

  recordType          ReconciliationRecordType

  attendanceRecordId  String?
  meetingAttendanceId String?

  reason              String                    @db.Text
  status              ReconciliationStatus      @default(PENDING)

  reviewerId          String?
  reviewedAt          DateTime?                 @db.Timestamptz(6)
  reviewNote          String?                   @db.Text

  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  attendanceRecord    AttendanceRecord?         @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)

  meetingAttendance   MeetingAttendance?        @relation(fields: [meetingAttendanceId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([traineeId])
  @@index([workspaceId, status])
  @@index([attendanceRecordId])
  @@index([meetingAttendanceId])
}


// ------------------------------------------------------------
// 8. Teams Identity Mapping
// ------------------------------------------------------------

model TeamsIdentityMapping {
  id              String   @id @default(uuid())
  workspaceId     String

  teamsUserId     String
  traineeId       String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([workspaceId, teamsUserId])
  @@index([workspaceId])
  @@index([traineeId])
}


// ------------------------------------------------------------
// 9. Integration Sync Status
// ------------------------------------------------------------

model IntegrationSyncStatus {
  id                 String                     @id @default(uuid())
  workspaceId        String

  provider           IntegrationProvider
  connectionStatus   IntegrationConnectionStatus

  lastSuccessfulSync DateTime?                  @db.Timestamptz(6)
  lastAttemptAt      DateTime?                  @db.Timestamptz(6)
  lastError          String?                    @db.Text

  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@index([connectionStatus])
}
