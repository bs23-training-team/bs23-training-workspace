enum UserRole {
  PM
  TRAINEE
}
 
model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  users                   User[]
  credentials             Credential[]
  sessions                Session[]
  invitations             AccountInvitation[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
 
  // E03: Assessment inverse relations
  e03ExpertiseVersion           ExpertiseVersion[]           @relation("E03ExpertiseVersionWorkspace")
  e03ExpertiseAnalysis          ExpertiseAnalysis[]          @relation("E03ExpertiseAnalysisWorkspace")
  e03AssessmentPolicy           AssessmentPolicy[]           @relation("E03AssessmentPolicyWorkspace")
  e03AssessmentPolicyRule       AssessmentPolicyRule[]       @relation("E03AssessmentPolicyRuleWorkspace")
  e03AssessmentProctoringPolicy AssessmentProctoringPolicy[] @relation("E03AssessmentProctoringPolicyWorkspace")
  e03AssessmentAttempt          AssessmentAttempt[]          @relation("E03AssessmentAttemptWorkspace")
  e03AssessmentQuestion         AssessmentQuestion[]         @relation("E03AssessmentQuestionWorkspace")
  e03AssessmentRubric           AssessmentRubric[]           @relation("E03AssessmentRubricWorkspace")
  e03AssessmentResponse         AssessmentResponse[]         @relation("E03AssessmentResponseWorkspace")
  e03AssessmentJob              AssessmentJob[]              @relation("E03AssessmentJobWorkspace")
  e03AssessmentEvaluation       AssessmentEvaluation[]       @relation("E03AssessmentEvaluationWorkspace")
  e03AssessmentResult           AssessmentResult[]           @relation("E03AssessmentResultWorkspace")
  e03AssessmentRecommendation   AssessmentRecommendation[]   @relation("E03AssessmentRecommendationWorkspace")
  e03AssessmentSession          AssessmentSession[]          @relation("E03AssessmentSessionWorkspace")
  e03AssessmentProctoringEvent  AssessmentProctoringEvent[]  @relation("E03AssessmentProctoringEventWorkspace")
  e03AssessmentProctoringSummary AssessmentProctoringSummary[] @relation("E03AssessmentProctoringSummaryWorkspace")
  e03AssessmentAppeal           AssessmentAppeal[]           @relation("E03AssessmentAppealWorkspace")
}
 
model User {
  id                 String    @id @default(uuid())
  workspaceId        String
  name               String
  email              String    @unique
  role               UserRole
  emailVerifiedAt    DateTime?
  activatedAt        DateTime?
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
 
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  credential Credential?
  sessions   Session[]
 
  receivedInvitations AccountInvitation[] @relation("InvitedUser")
  createdInvitations  AccountInvitation[] @relation("InvitationCreator")
 
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
 
  // E03: Assessment inverse relations
  e03ExpertiseVersions ExpertiseVersion[] @relation("E03ExpertiseTrainee")
  e03SubmittedAppeals  AssessmentAppeal[] @relation("E03AppealSubmitter")
  e03ReviewedAppeals   AssessmentAppeal[] @relation("E03AppealReviewer")
 
  @@index([workspaceId])
}
 
model Credential {
  id           String   @id @default(uuid())
  workspaceId  String
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
 
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
 
  @@index([workspaceId])
}
 
model Session {
  id               String    @id @default(uuid())
  workspaceId      String
  userId           String
  refreshTokenHash String
  device           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastSeenAt       DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
 
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
 
  @@index([workspaceId])
  @@index([userId])
  @@index([expiresAt])
}
 
model AccountInvitation {
  id              String    @id @default(uuid())
  workspaceId     String
  userId          String
  createdByUserId String
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
 
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation("InvitedUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User      @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
 
  @@index([workspaceId])
  @@index([userId])
  @@index([expiresAt])
}
 
model EmailVerificationToken {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
 
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
 
  @@index([workspaceId])
  @@index([userId])
  @@index([expiresAt])
}
 
model PasswordResetToken {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
 
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
 
  @@index([workspaceId])
  @@index([userId])
  @@index([expiresAt])

}
model PasswordResetToken {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
 
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
 
  @@index([workspaceId])
  @@index([userId])
  @@index([expiresAt])
  }

model Notification {
  id          String    @id @default(uuid())
  workspaceId String
  recipientId String
  type        String
  title       String
  message     String
  link        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  recipient User      @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([workspaceId, recipientId])
  @@index([recipientId, readAt])
  @@index([createdAt])
}

model Preference {
  id           String  @id @default(uuid())
  workspaceId  String
  userId       String
  category     String
  emailEnabled Boolean @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, category])
  @@index([workspaceId])
}

model OutboxEvent {
  id            String    @id @default(uuid())
  eventType     String
  eventVersion  Int       @default(1)
  workspaceId   String
  aggregateType String
  aggregateId   String
  actorUserId   String?
  payload       Json
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?
  createdAt     DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor     User?      @relation("OutboxEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([publishedAt, createdAt])
  @@index([aggregateType, aggregateId])
}