// ============================================================================
// Owner: E06 (daily sprint, sheets, meetings)
// Module M6 - Daily Sprint (DS). Source: BS23 PRD v1.1 + SRS v1.1
// (FR-DS-01 .. FR-DS-08, US-10, US-11)
//
// Mapping from the planned record names (SRS p.8):
//   Task             -> SprintTask
//   Submission       -> SprintSubmission
//   Week             -> SprintWeek
//   SheetCellVersion -> DSCell + DSCellVersion
//   DSMeeting        -> DSMeeting
//   QualityScan, ProjectReview -> removed (PRD v1.1, FR-DS-09 is retired)
//
// Rules used here (same as E01 identity schema):
//   - every model has workspaceId + relation to Workspace + @@index
//   - onDelete: Restrict everywhere (history is never cascade-deleted)
//   - relation names are prefixed E06 so they never clash with other modules
//
// Tags: [PRD] = written in PRD/SRS.  [PROPOSED] = my assumption, PM to confirm
//       (Q numbers are from the E06 PRD document).
//
// NOT in this file (retired or generated):
//   - repo links, SonarQube, project review (FR-DS-09 retired)
//   - PM weekly report: generated on demand from the sheet [PROPOSED, Q11]
//
// Team model does not exist yet (owner: E02). teamId stays a plain String
// until it does. See the TODO at the bottom.
// Time zone is still open (Q4): instants are stored as DateTime (UTC),
// calendar days as @db.Date. The 10:00 cutoff is checked in code.
// ============================================================================

// ----------------------------------------------------------------------------
// Enums (prefixed so they do not clash with other modules)
// ----------------------------------------------------------------------------

// [PRD] FR-DS-02: category is only SBO or L&D
enum SprintTaskCategory {
  SBO
  LND // L&D
}

// [PRD] FR-DS-04: sheet columns
enum DSColumn {
  PLAN      // "Sprint Plan Tasks": once per week, not per day [PROPOSED, Q3]
  YESTERDAY // What I did yesterday
  HOURS     // Spent hours
  TODAY     // What I will do today
  BLOCKERS  // Blockers
}

// [PRD] FR-DS-08: one team or all teams
enum DSMeetingAudience {
  TEAM
  ALL
}

// ----------------------------------------------------------------------------
// 1. SprintTask (FR-DS-02): a trainee's dated task
// ----------------------------------------------------------------------------
model SprintTask {
  id          String             @id @default(uuid())
  workspaceId String
  traineeId   String
  teamId      String // [PROPOSED, Q1] a trainee can be in many teams
  date        DateTime           @db.Date // [PRD] day of the task
  title       String // [PRD] required
  description String? // [PRD] optional
  category    SprintTaskCategory // [PRD]

  // Time is stored in whole minutes (90 = 1.5 hours). 0..1440, 15 minute step.
  // Checked in the NestJS DTO. [PROPOSED, Q8]
  plannedMinutes Int  @default(0)
  actualMinutes  Int?

  plannedStart DateTime? // [PRD] plannedEnd must be after plannedStart (DTO check)
  plannedEnd   DateTime?

  blocker String? // [PRD]

  done        Boolean   @default(false) // [PRD data model]
  completedAt DateTime? // [PROPOSED, Q6]

  // [PROPOSED, Q5] unfinished task copied to the next day: points to the original
  carriedFromId String?
  carriedFrom   SprintTask?  @relation("E06SprintTaskCarried", fields: [carriedFromId], references: [id], onDelete: Restrict)
  carriedTo     SprintTask[] @relation("E06SprintTaskCarried")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation("E06SprintTaskWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  trainee   User      @relation("E06SprintTaskTrainee", fields: [traineeId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([workspaceId, traineeId, date]) // trainee board, 2-week summary
  @@index([workspaceId, teamId, date]) // PM sheet
  @@index([carriedFromId])
}

// ----------------------------------------------------------------------------
// 2. SprintSubmission (FR-DS-03): one submission per trainee per day
// ----------------------------------------------------------------------------
model SprintSubmission {
  id          String   @id @default(uuid())
  workspaceId String
  traineeId   String
  date        DateTime @db.Date // [PRD]
  submittedAt DateTime @default(now()) // [PRD] "time"
  onTime      Boolean // [PRD] true if at or before the cutoff (default 10:00)

  workspace Workspace @relation("E06SprintSubmissionWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  trainee   User      @relation("E06SprintSubmissionTrainee", fields: [traineeId], references: [id], onDelete: Restrict)

  @@unique([traineeId, date]) // [PRD] one submission per day
  @@index([workspaceId])
  @@index([workspaceId, date])
}

// ----------------------------------------------------------------------------
// 3. SprintWeek (FR-DS-04, FR-DS-05): one weekly tab of a team sheet
// ----------------------------------------------------------------------------
// One team + one week = one sheet. "Add Sprint" creates the next row.
// A date with no SprintWeek cannot be opened (checked in code).
model SprintWeek {
  id          String   @id @default(uuid())
  workspaceId String
  teamId      String
  weekStart   DateTime @db.Date // [PRD] Monday
  createdById String // PM
  createdAt   DateTime @default(now())

  workspace Workspace @relation("E06SprintWeekWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy User      @relation("E06SprintWeekCreator", fields: [createdById], references: [id], onDelete: Restrict)
  cells     DSCell[]

  @@unique([teamId, weekStart]) // pressing Add Sprint twice cannot make two weeks
  @@index([workspaceId])
  @@index([workspaceId, teamId])
}

// ----------------------------------------------------------------------------
// 4. DSCell (FR-DS-04, FR-DS-06): one cell of the team sheet
// ----------------------------------------------------------------------------
// Cell = (week, trainee, day, column).
// For the PLAN column, date = the week's weekStart (never null), so the
// unique rule works. [PROPOSED, Q3]
//
// authorId    = who first wrote the cell   [PRD: original author kept]
// updatedById = who edited it last         [PRD]
// version     = increases on every save; an old version is a conflict [PRD]
model DSCell {
  id           String   @id @default(uuid())
  workspaceId  String
  sprintWeekId String
  traineeId    String
  date         DateTime @db.Date
  column       DSColumn
  value        String   @default("")

  authorId    String
  updatedById String
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace       @relation("E06DSCellWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  sprintWeek SprintWeek      @relation(fields: [sprintWeekId], references: [id], onDelete: Restrict)
  trainee    User            @relation("E06DSCellTrainee", fields: [traineeId], references: [id], onDelete: Restrict)
  author     User            @relation("E06DSCellAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  updatedBy  User            @relation("E06DSCellUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  history    DSCellVersion[]

  @@unique([sprintWeekId, traineeId, date, column])
  @@index([workspaceId])
  @@index([sprintWeekId, traineeId])
}

// ----------------------------------------------------------------------------
// 5. DSCellVersion (FR-DS-06): edit history of a cell
// ----------------------------------------------------------------------------
// One row per save. Rows are never updated or deleted.
// [PROPOSED: not in the data model, but "edit history" needs a place to live]
model DSCellVersion {
  id          String   @id @default(uuid())
  workspaceId String
  cellId      String
  version     Int
  value       String
  actorId     String
  createdAt   DateTime @default(now())

  workspace Workspace @relation("E06DSCellVersionWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  cell      DSCell    @relation(fields: [cellId], references: [id], onDelete: Restrict)
  actor     User      @relation("E06DSCellVersionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([cellId, version])
  @@index([workspaceId])
  @@index([cellId, createdAt])
}

// ----------------------------------------------------------------------------
// 6. DSMeeting (FR-DS-08)
// ----------------------------------------------------------------------------
// Only the Teams link is saved. We never create a Teams meeting (PRD non-goal).
// audience = ALL means teamId is empty.
model DSMeeting {
  id          String            @id @default(uuid())
  workspaceId String
  title       String
  audience    DSMeetingAudience
  teamId      String? // required when audience = TEAM
  scheduledAt DateTime // [PRD] date + time as one instant (Q4)
  teamsLink   String? // optional, https only (DTO check)
  createdById String // PM
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace @relation("E06DSMeetingWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy User      @relation("E06DSMeetingCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([workspaceId, scheduledAt])
  @@index([teamId, scheduledAt])
}

